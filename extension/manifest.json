{
  "manifest_version": 3,
  "name": "PrairieRun",
  "version": "0.1.0",
  "description": "Scan PrairieLearn assignments and stage them for Google Calendar.",
  "action": {
    "default_title": "PrairieRun",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "identity",
    "alarms",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://canvas.illinois.edu/*",
    "https://www.gradescope.com/*",
    "https://us.prairietest.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://us.prairielearn.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://us.prairielearn.com/*"
      ],
      "js": [
        "compat.js",
        "prairielearn-adapter.js",
        "view-utils.js",
        "home-panel.js",
        "identity-resolver.js",
        "content.js"
      ],
      "css": [
        "home-panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
